{
  "name": "alfc",
  "version": "2.0.0",
  "author": "Andreas Opferkuch <andreas.opferkuch@gmail.com>",
  "contributors": [
    "Marko Bogosavljevic <markox123@icloud.com>"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.0"
  },
  "private": true,
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "build": "bun run --parallel --workspaces build",
    "start": "bun run --parallel --workspaces start",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "vitest",
    "type-check": "bun run --workspaces type-check",
    "del:tscache": "del-cli \"**/*.tsbuildinfo\" \"!**/node_modules/**\"",
    "all-checks": "bun run lint && bun run type-check && bun run test && bun run build"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.6",
    "@eslint/js": "^9.19.0",
    "@types/bun": "^1.4.0",
    "@types/eslint__js": "^8.42.3",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5"
  },
  "packageManager": "bun@1.4.0"
}
