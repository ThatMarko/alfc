{
  "name": "alfc",
  "version": "2.0.0",
  "author": "Andreas Opferkuch <andreas.opferkuch@gmail.com>",
  "contributors": [
    "Marko Bogosavljevic <markox123@icloud.com>"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.9"
  },
  "private": true,
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "build": "bun run --parallel --filter frontend --filter server build",
    "start": "bun run --parallel --filter frontend --filter server start",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "vitest",
    "type-check": "bun run --filter frontend --filter server type-check",
    "del:tscache": "del-cli \"**/*.tsbuildinfo\" \"!**/node_modules/**\"",
    "all-checks": "bun run lint && bun run type-check && bun run test && bun run build"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@types/bun": "1.3.9",
    "@types/eslint__js": "^8.42.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "bun@1.3.9"
}
