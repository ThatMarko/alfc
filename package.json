{
  "name": "alfc",
  "version": "2.0.0",
  "author": "Andreas Opferkuch <andreas.opferkuch@gmail.com>",
  "contributors": [
    "Marko Bogosavljevic <markox123@icloud.com>"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.3",
    "node": "^24.11.0"
  },
  "private": true,
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "build": "bun run --parallel --filter frontend --filter server build",
    "start": "bun run --parallel --filter frontend --filter server start",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "bun run --filter frontend --filter server type-check",
    "del:tscache": "bun clean-tscache.ts",
    "all-checks": "bun run lint && bun run type-check && bun run test && bun run build",
    "test:web": "playwright test"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.26.7",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "bun@1.4.3"
}
