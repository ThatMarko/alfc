  "scripts": {
    "build": "bun build.ts",
    "build:cpuoc": "dotnet publish native/windows/cpuoc-dotnet -c Release -o native/windows",
    "build:wmidll": "native\\windows\\wmidll\\build.bat",
    "start": "bun --watch index.ts",
    "start:prod": "NODE_ENV=production ./dist/alfc",
    "debug:acpi": "bun native/windows/acpi.ts",
    "debug:oc": "bun run build:cpuoc && bun native/windows/cpuoc.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "json-stringify-pretty-compact": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1"
  }
}
