post_install() {
  echo "==> ALFC installed."
  echo ""
  echo "  Fan control requires the acpi_call module for your running kernel."
  echo "  Use acpi_call for linux, acpi_call-lts for linux-lts, or DKMS with"
  echo "  matching headers. Example for the standard linux kernel:"
  echo "    sudo pacman -Syu acpi_call-dkms linux-headers"
  echo "  For linux-lts use linux-lts-headers; custom kernels need their headers."
  echo "  Choose one module package; prebuilt and DKMS packages conflict."
  echo "  Then load it:"
  echo "    sudo modprobe acpi_call"
  echo "  Auto-load on boot:"
  echo "    echo 'acpi_call' | sudo tee /etc/modules-load.d/acpi_call.conf"
  echo ""
  echo "  Start the service:"
  echo "    sudo systemctl enable --now alfc"
  echo ""
  echo "  Web UI: http://localhost:5522"
  echo ""
  echo "  KDE Plasma 6 widget (optional):"
  echo "    /usr/lib/alfc/plasmoid/install.sh"
}

post_upgrade() {
  echo "==> ALFC upgraded."
  echo ""
  echo "  Restart the service: sudo systemctl restart alfc"
  echo ""
  echo "  Upgrade KDE widget as the desktop user (if installed):"
  echo "    /usr/lib/alfc/plasmoid/install.sh"
}

pre_remove() {
  # The installed AbortOnFail pre-transaction hook is the removal guard. This
  # fallback also waits for activating/deactivating units; its return alone
  # cannot abort libalpm's transaction if the hook was unavailable or disabled.
  systemctl stop alfc || return $?
  if systemctl is-enabled --quiet alfc 2>/dev/null; then
    systemctl disable alfc
  fi
}

post_remove() {
  echo "==> ALFC removed."
  echo ""
  echo "  To remove the KDE widget (if installed):"
  echo "    Run ./plasmoid/uninstall.sh from an extracted ALFC release as the desktop user."
  echo ""
  echo "  Config file preserved at /usr/lib/alfc/alfc.config.json.pacsave (if modified)"
}
