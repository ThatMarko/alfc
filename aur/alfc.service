[Unit]
Description=Aorus Laptop Fan Control
After=network.target

[Service]
Type=simple
WorkingDirectory=/usr/lib/alfc
ExecStart=/usr/lib/alfc/alfc
Environment=NODE_ENV=production
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening — restrict what the root service can access
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/proc/acpi/call /usr/lib/alfc
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
